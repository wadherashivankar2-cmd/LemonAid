# ==============================================================================
# Next.js Frontend Production Environment Configuration
# ==============================================================================

# Backend FastAPI URL (local or Hugging Face Space URL)
NEXT_PUBLIC_API_URL=http://localhost:7860

# Canonical public web origin for OpenGraph social cards and canonical links
NEXT_PUBLIC_SITE_URL=https://mr-roast.vercel.app

# Shared HMAC-SHA256 secret for validating and signing share cards. MUST match api/ SHARE_SECRET
SHARE_SECRET=dev_secret_key_must_be_shared_with_frontend
