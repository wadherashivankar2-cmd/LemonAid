# ==============================================================================
# Hugging Face Space / FastAPI Production Environment Configuration
# ==============================================================================

# CORS: Comma-separated list of allowed web frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://mr-roast.vercel.app

# Cosine retrieval similarity threshold (determined by eval.py sweep)
RETR_MIN=0.30

# Re-rank threshold for future cross-encoder pipeline
RERANK_MIN=0.45

# Shared HMAC-SHA256 secret for tamper-proof share cards. MUST match web/ SHARE_SECRET
SHARE_SECRET=dev_secret_key_must_be_shared_with_frontend

# Upstash Redis REST credentials (optional; falls back automatically to in-memory)
UPSTASH_URL=https://your-database-id.upstash.io
UPSTASH_TOKEN=your_upstash_rest_token_here

# Space server port (default: 7860 for Hugging Face Spaces)
PORT=7860

# Allow draft roasts during development / local verification
ALLOW_DRAFT=1
